func handler(f) (..args) {
    result := try f(..args);
    if (result is err e)
        print("Uncaught error: {}\n".format(e));
};

func start(scope: null) {
    lang := switch meta.languages.keys {
        [] => {
            print('No valid language, REPL is unavailable!\n');
            exit(1)
        },
        [of _ lang] => {
            print('Using language: {}.\n'.format(lang));
            lang
        },
        of _ keys => {
            print('Found multiple valid languages: {}. Select one: '.format(keys));
            lang := input().trim();
            if (keys.iter().contains(lang)) lang
            else {
                print('No such language: {}!\n'.format(lang));
                exit(1)
            }
        }
    };

    scope ??= Scope();

    func pos(bytecode) {
        pos := bytecode.vars.at('pos');
        if (pos is null) return '??';
        [line, column, stopLine, stopColumn] := pos;
        switch [line == stopLine, column == stopColumn] {
            [true, true] => '{0}:{1}',
            [true, false] => '{0}:{1}~{3}',
            _ => '{0}:{1}~{2}:{3}'
        }.format(..pos)
    };

    extend scope {
        func help() {
            print('help()        Print this help message.\n');
            print('comp(code)    Compile and print bytecodes.\n');
            print('file(name)    Load a file into the REPL session.\n');
            print('exit()        Exit REPL.\n');
        };

        @handler
        func comp(code)
            for (b : meta.compile(Frame.CodeSource.code('bish', code)).bytecodes)
                print('{}\t{}\n'.format(pos(b), b));

        @handler
        func file(name) meta.compile(Frame.CodeSource.file(name), scope).execute();
    };

    @handler
    func run(code) {
        result := meta.compile(Frame.CodeSource.code('bish', code), scope).eval();
        if (result is not null) print('{:?}\n'.format(result));
    };

    print('Welcome to Bish REPL!\n');
    print('Type "help()" for more information.\n');
    while (true) {
        print('>>> ');
        code := input().trim();
        if (code != '') run(code);
    };
};

extend Frame {
    @handler
    func handledExecute(self) self.execute();
};